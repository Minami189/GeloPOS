{
  "name": "gelopos",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node -e \"const fs = require('fs'); if (fs.existsSync('public')) { fs.readdirSync('public').forEach(file => { if (file !== 'index.html') fs.copyFileSync('public/' + file, 'dist/' + file); }); }\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@react-navigation/native": "^7.1.31",
    "@react-navigation/native-stack": "^7.14.2",
    "@supabase/supabase-js": "^2.98.0",
    "base64-arraybuffer": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "expo": "~54.0.33",
    "expo-image-picker": "~17.0.10",
    "expo-print": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "lucide-react-native": "^0.575.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.0"
  },
  "private": true
}
